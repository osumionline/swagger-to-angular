{
  "openapi": "3.0.0",
  "servers": [
    {
      "url": "https://example.com/parameterreferences"
    }
  ],
  "components": {
    "schemas": {
      "ItemId": {
        "type": "string"
      },
      "Tag": {
        "type": "string"
      },
      "TagList": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/Tag"
        }
      },
      "Role": {
        "type": "string"
      },
      "Filter": {
        "type": "object",
        "properties": {
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "active": {
            "type": "boolean"
          }
        }
      },
      "RequestVersion": {
        "type": "integer"
      }
    }
  },
  "paths": {
    "/v1/items/{id}": {
      "get": {
        "operationId": "getItemByReference",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ItemId"
            }
          },
          {
            "name": "tags",
            "in": "query",
            "style": "form",
            "explode": false,
            "schema": {
              "$ref": "#/components/schemas/TagList"
            }
          },
          {
            "name": "X-Version",
            "in": "header",
            "schema": {
              "$ref": "#/components/schemas/RequestVersion"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    },
    "/v1/search": {
      "get": {
        "operationId": "searchWithReferencedFilter",
        "parameters": [
          {
            "name": "filter",
            "in": "query",
            "style": "form",
            "explode": false,
            "schema": {
              "$ref": "#/components/schemas/Filter"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    }
  }
}
