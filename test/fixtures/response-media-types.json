{
  "openapi": "3.1.0",
  "servers": [
    {
      "url": "https://example.com/responsemediatypes"
    }
  ],
  "components": {
    "schemas": {
      "Status": {
        "type": "object",
        "required": ["ok"],
        "properties": {
          "ok": { "type": "boolean" }
        }
      }
    },
    "responses": {
      "PlainText": {
        "description": "Plain text response",
        "content": {
          "text/plain": {
            "schema": { "type": "string" }
          }
        }
      }
    }
  },
  "paths": {
    "/v1/vendor": {
      "get": {
        "operationId": "getVendorStatus",
        "responses": {
          "200": {
            "content": {
              "application/vnd.api+json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          }
        }
      }
    },
    "/v1/text": {
      "get": {
        "operationId": "getPlainText",
        "responses": {
          "200": {
            "$ref": "#/components/responses/PlainText"
          }
        }
      }
    },
    "/v1/text-create": {
      "post": {
        "operationId": "createPlainText",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "type": "string" }
            }
          }
        },
        "responses": {
          "201": {
            "content": {
              "text/plain": {}
            }
          }
        }
      }
    },
    "/v1/text-remove": {
      "delete": {
        "operationId": "removePlainText",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "type": "string" }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "text/plain": {}
            }
          }
        }
      }
    },
    "/v1/mixed": {
      "get": {
        "operationId": "getMixedResponse",
        "responses": {
          "200": {
            "content": {
              "application/pdf": {},
              "application/json": {
                "schema": { "type": "boolean" }
              }
            }
          }
        }
      }
    },
    "/v1/export": {
      "get": {
        "operationId": "downloadBinaryFile",
        "responses": {
          "200": {
            "content": {
              "application/octet-stream": {}
            }
          }
        }
      }
    }
  }
}
